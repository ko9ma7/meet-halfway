# Map provider: kakao | osm | google
MAP_PROVIDER=kakao

# Kakao Developers > 앱 > 플랫폼 키에서 확인한 JavaScript Key
# GitHub Pages의 실제 배포 도메인을 JavaScript SDK 도메인에 등록해야 합니다.
KAKAO_MAPS_JAVASCRIPT_KEY=YOUR_KAKAO_JAVASCRIPT_KEY

# Google을 선택할 때만 사용합니다.
GOOGLE_MAPS_API_KEY=

# Supabase Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# 배포 주소. canonical/OG/robots/sitemap 생성에 사용됩니다.
PUBLIC_SITE_URL=https://USERNAME.github.io/meet-halfway

GEOCODING_COUNTRY_CODES=kr
OVERPASS_RADIUS_METERS=2500
DEFAULT_LANGUAGE=auto
DEFAULT_STYLE=aurora
